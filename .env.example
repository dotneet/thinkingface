# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# `docker-compose.yml` loads this file via `env_file` for the `api` service
# and reads a few values directly for `postgres` / `web`. Anything left
# blank falls back to the default baked into docker-compose.yml.

# ---- postgres --------------------------------------------------------
POSTGRES_USER=tf
POSTGRES_PASSWORD=tf
POSTGRES_DB=thinkingface
# Port used to connect to postgres from the host (for `make test-store-pg`).
POSTGRES_PORT=5432

# ---- DATABASE_URL (the value the backend actually reads) ----------------
# By default, docker-compose.yml's `api` service builds
# postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# from the POSTGRES_* values above and passes it in, so setting DATABASE_URL
# here has no effect on a compose-driven start (this comment is only for
# standalone runs / reference).
#
# The scheme switches between PostgreSQL and SQLite:
#   postgres:// / postgresql://  -> PostgreSQL (pgx)
#   sqlite://                    -> SQLite (pure Go, modernc.org/sqlite)
#
# To bring up the whole stack in SQLite mode, use `make up-sqlite`
# (docker-compose.sqlite.yml). Example of running the backend standalone
# without docker:
#   DATABASE_URL=sqlite:///tmp/thinkingface.db
# DATABASE_URL=sqlite:///tmp/thinkingface.db

# Litestream replica destination for when production uses SQLite mode (a
# single Cloud Run instance). When set, the container's entrypoint restores
# from it on startup before starting serve via `litestream replicate -exec`.
# Fine to leave unset locally (the docker-compose environment gets by with a
# single volume even in SQLite mode, so Litestream isn't used there).
# TF_LITESTREAM_REPLICA_URL=gs://bucket/litestream/thinkingface.db

# ---- api / thinkingface backend --------------------------------------
TF_ADDR=:8080
TF_PUBLIC_URL=http://localhost:8080

# GCS (fake-gcs-server locally; STORAGE_DRIVER=gcs + real bucket in prod)
STORAGE_DRIVER=gcs-emulator
GCS_BUCKET=thinkingface
GCS_PREFIX=
STORAGE_EMULATOR_HOST=http://gcs:4443

TF_SIGNED_URL_TTL=1h
TF_VIEWER_CACHE_DIR=/data/cache
# Workers pick up post-push jobs (publishing blobs, re-indexing metadata).
# They parallelise across refs; jobs for one repository and ref are always
# serialised, so raising this cannot interleave two syncs of the same ref.
TF_SYNC_WORKERS=2

# How long the native ingest API's metric points may stay database-only before
# the sync worker commits them into the dataset repository's parquet
# (docs/dev/thinkingface-design.md §8). A run that reaches finished/failed is
# always flushed at once. 0 disables the flush.
TF_EXP_FLUSH_INTERVAL=1m

# Initial admin account, seeded on first boot when the users table is empty.
TF_ADMIN_USERNAME=admin
TF_ADMIN_PASSWORD=admin
TF_ADMIN_EMAIL=admin@example.com

# Change this for anything beyond local development.
# If TF_PUBLIC_URL starts with https://, leaving the default here **causes
# startup to be refused** (a value of at least 32 bytes is required). Same
# for TF_ADMIN_PASSWORD.
TF_SESSION_SECRET=dev-insecure-session-secret

# How long the session cookie (tf_session) stays valid. It is also
# invalidated server-side on logout and password change (users.session_epoch).
TF_SESSION_TTL=168h

# Whether to set Secure on tf_session. If unset, it is inferred from whether
# TF_PUBLIC_URL is https. In a setup where TLS is terminated at a load
# balancer and traffic is plain HTTP internally, that inference gets it
# wrong, so set this explicitly to true in that case.
# TF_COOKIE_SECURE=true

# Browser origins allowed for credentialed CORS (comma-separated).
# If unset, the default is TF_PUBLIC_URL's origin plus (only over http)
# http://localhost:3000 / http://127.0.0.1:3000.
# In production, if the web UI is on a different host than the API, the UI
# will not work unless this is set. Origins outside the allowlist get no CORS
# headers back, and state-changing requests (POST/PUT/PATCH/DELETE) under a
# cookie session are also rejected with 403.
# TF_ALLOWED_ORIGINS=https://hub.example.com,https://api.hub.example.com

# Threshold for rate-limiting failed password authentication (per IP, per
# minute). Half that for the same username. Only failures are counted;
# success resets it. Applies to both login and HTTP Basic (accepted on every
# route). 0 disables it.
# The counter is process-local, so with multiple replicas the limit applies
# per replica.
TF_AUTH_RATE_LIMIT_PER_MIN=10

# Use the first entry of X-Forwarded-For to identify the client for rate
# limiting. Only set this to true in a setup where a proxy you control
# overwrites this header (otherwise a client could pick its own bucket).
# TF_TRUST_PROXY_IPS=false

# Allow self-service signup (set to false to make admin the only account).
TF_ALLOW_SIGNUP=true

# Who can create organizations: anyone (default) or admin (site admins only).
TF_ORG_CREATION=anyone

# ---- git over SSH (docs/dev/thinkingface-design.md §5) ----------------------
# Public key auth only; keys are registered in the web UI at
# /settings/ssh-keys. Clone with:
#   git clone ssh://git@localhost:2222/<ns>/<name>.git
TF_SSH_ENABLED=true
TF_SSH_ADDR=:2222
# The host key is generated on first start if missing. It MUST live on
# persistent storage: on an ephemeral filesystem every restart mints a new
# identity and clients see a host key mismatch.
TF_SSH_HOST_KEY_PATH=/data/ssh/host_ed25519
TF_SSH_IDLE_TIMEOUT=10m

# ---- web / frontend ----------------------------------------------------
# Browser-facing API URL. Keep this pointed at localhost even though the
# `web` container reaches `api` via the internal `API_URL` value, since the
# browser itself is outside the compose network.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Continuity / WAL (docs/dev/continuity-design.md) ---
# off | shadow | authoritative
TF_WAL_MODE=shadow
# core.hooksPath baked into the image; required whenever TF_WAL_MODE != off
TF_GIT_HOOKS_PATH=/opt/thinkingface/hooks
# byte budgets for the two local caches (both tmpfs on Cloud Run)
TF_GIT_CACHE_BYTES=2147483648
TF_VIEWER_CACHE_BYTES=4294967296
