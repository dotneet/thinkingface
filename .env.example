# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# `docker-compose.yml` loads this file via `env_file` for the `api` service,
# but its `environment:` block sets most of these same keys again with a
# `${VAR:-default}` expansion read from the top-level `.env` in this
# directory (docker compose auto-loads that for variable substitution,
# separately from `env_file:`) -- `environment:` wins over `env_file` for any
# key both define, so this second layer is what actually makes setting a
# value here take effect. `postgres` / `web` read a few values directly the
# same way. Anything left blank falls back to the default baked into
# docker-compose.yml. A small number of api settings (GIT_ROOT,
# TF_GIT_HOOKS_PATH) are hardcoded in docker-compose.yml instead, since
# they're tied to that file's own volume mount / baked-in image path and
# aren't meant to be overridden there.

# ---- postgres --------------------------------------------------------
POSTGRES_USER=tf
POSTGRES_PASSWORD=tf
POSTGRES_DB=thinkingface
# Port used to connect to postgres from the host (for `make test-store-pg`).
POSTGRES_PORT=5432

# ---- DATABASE_URL (the value the backend actually reads) ----------------
# By default, docker-compose.yml's `api` service builds
# postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# from the POSTGRES_* values above and passes it in, so setting DATABASE_URL
# here has no effect on a compose-driven start (this comment is only for
# standalone runs / reference).
#
# The scheme switches between PostgreSQL and SQLite:
#   postgres:// / postgresql://  -> PostgreSQL (pgx)
#   sqlite://                    -> SQLite (pure Go, modernc.org/sqlite)
#
# To bring up the whole stack in SQLite mode, use `make up-sqlite`
# (docker-compose.sqlite.yml). Example of running the backend standalone
# without docker:
#   DATABASE_URL=sqlite:///tmp/thinkingface.db
# DATABASE_URL=sqlite:///tmp/thinkingface.db

# Litestream replica destination for when production uses SQLite mode (a
# single Cloud Run instance). When set, the container's entrypoint restores
# from it on startup before starting serve via `litestream replicate -exec`.
# Fine to leave unset locally (the docker-compose environment gets by with a
# single volume even in SQLite mode, so Litestream isn't used there).
# TF_LITESTREAM_REPLICA_URL=gs://bucket/litestream/thinkingface.db

# ---- api / thinkingface backend --------------------------------------
TF_ADDR=:8080
TF_PUBLIC_URL=http://localhost:8080

# GCS (fake-gcs-server locally; STORAGE_DRIVER=gcs + real bucket in prod)
STORAGE_DRIVER=gcs-emulator
GCS_BUCKET=thinkingface
GCS_PREFIX=
STORAGE_EMULATOR_HOST=http://gcs:4443

# Floor of a signed transfer URL's lifetime. The actual lifetime is derived
# from the object's byte count and clamped into [TF_SIGNED_URL_TTL,
# TF_SIGNED_URL_MAX_TTL], so this only matters for small transfers.
TF_SIGNED_URL_TTL=1h
# Ceiling of the same clamp, for large transfers. Also bounds how long an
# interrupted LFS upload may sit in tmp/uploads/ before `thinkingface gc`
# treats it as abandoned.
TF_SIGNED_URL_MAX_TTL=12h
# Scratch directory for WAL compaction work (backend/cmd/thinkingface/walops.go).
# The parquet viewer no longer caches to disk here -- it reads objects via
# storage range requests instead (see TF_VIEWER_METADATA_CACHE_BYTES below).
TF_VIEWER_CACHE_DIR=/data/cache
# Workers pick up post-push jobs (publishing blobs, re-indexing metadata).
# They parallelise across refs; jobs for one repository and ref are always
# serialised, so raising this cannot interleave two syncs of the same ref.
TF_SYNC_WORKERS=2

# How long the native ingest API's metric points may stay database-only before
# the sync worker commits them into the dataset repository's parquet
# (docs/dev/thinkingface-design.md §8). A run that reaches finished/failed is
# always flushed at once. 0 disables the flush.
TF_EXP_FLUSH_INTERVAL=1m

# Initial admin account, seeded on first boot when the users table is empty.
TF_ADMIN_USERNAME=admin
TF_ADMIN_PASSWORD=admin
TF_ADMIN_EMAIL=admin@example.com

# Change this for anything beyond local development.
# Unless TF_PUBLIC_URL points at localhost (or a loopback address), leaving
# the default here **causes startup to be refused** -- a private value of at
# least 32 bytes is required, whether the instance is served over https or
# plain http. The same applies to TF_ADMIN_PASSWORD.
#
# This is not only an https concern: the value below is published in this
# file, and it signs tf_session, whose payload is `<userID>.<epoch>.<expiry>`.
# Anyone who knows it can mint a cookie for user id 1 -- the initial
# administrator -- against an instance reachable on a VPN or an office LAN
# just as easily as one on the public internet.
#
#   openssl rand -hex 32
TF_SESSION_SECRET=dev-insecure-session-secret

# How long the session cookie (tf_session) stays valid. It is also
# invalidated server-side on logout and password change (users.session_epoch).
TF_SESSION_TTL=168h

# Whether to set Secure on tf_session. If unset, it is inferred from whether
# TF_PUBLIC_URL is https. In a setup where TLS is terminated at a load
# balancer and traffic is plain HTTP internally, that inference gets it
# wrong, so set this explicitly to true in that case.
# TF_COOKIE_SECURE=true

# Browser origins allowed for credentialed CORS (comma-separated).
# If unset, the default is TF_PUBLIC_URL's origin plus (only over http)
# http://localhost:3000 / http://127.0.0.1:3000.
# In production, if the web UI is on a different host than the API, the UI
# will not work unless this is set. Origins outside the allowlist get no CORS
# headers back, and state-changing requests (POST/PUT/PATCH/DELETE) under a
# cookie session are also rejected with 403.
# TF_ALLOWED_ORIGINS=https://hub.example.com,https://api.hub.example.com

# Threshold for rate-limiting failed password authentication (per IP, per
# minute). Half that for the same username. Only failures are counted;
# success resets it. Applies to both login and HTTP Basic (accepted on every
# route). 0 disables it.
# The counter is process-local, so with multiple replicas the limit applies
# per replica.
TF_AUTH_RATE_LIMIT_PER_MIN=10

# Identify the client from X-Forwarded-For rather than from the connection
# peer, for rate limiting and for the client_ip in the authentication log.
# Only set this to true when a proxy you control is in front: with no proxy
# there, the whole header is whatever the client typed.
# TF_TRUST_PROXY_IPS=false

# How many X-Forwarded-For entries those proxies appended. The client is read
# that many places from the *right*, never from the left -- every proxy this
# runs behind appends (GCLB, Cloud Run, nginx's proxy_add_x_forwarded_for), so
# the leftmost entry is client-supplied and reading it would let a caller pick
# its own rate-limit bucket on every request.
#   1  a single proxy, e.g. Cloud Run reached directly
#   2  Cloud Run (or any backend) behind a Google load balancer, which appends
#      the client and then the GFE
# A header with fewer entries than this is ignored and the connection peer is
# used instead. Only read when TF_TRUST_PROXY_IPS=true.
# TF_TRUSTED_PROXY_HOPS=1

# Allow self-service signup (set to false to make admin the only account).
TF_ALLOW_SIGNUP=true

# Restrict self-service signup to these email domains (comma separated).
# Empty means no restriction. Matched case-insensitively and exactly:
# example.com admits alice@example.com and refuses alice@sub.example.com.
# TF_SIGNUP_EMAIL_DOMAINS=

# Hold self-service signups until a site administrator approves them at
# /settings/admin/users. A pending account authenticates on nothing at all --
# not its password, not an access token, not an SSH key -- and is issued no
# session. Existing accounts, and accounts an administrator creates, are
# already approved.
# TF_SIGNUP_REQUIRE_APPROVAL=false

# Default storage quota, in bytes, for a namespace with no override of its
# own. 0 (the default) is unlimited. Enforced when Git LFS uploads are
# requested, so it caps what a namespace can put in the bucket; a site
# administrator overrides it per namespace at /settings/admin/namespaces.
# TF_DEFAULT_STORAGE_QUOTA_BYTES=0

# Who can create organizations: anyone (default) or admin (site admins only).
TF_ORG_CREATION=anyone

# ---- git over SSH (docs/dev/thinkingface-design.md §5) ----------------------
# Public key auth only; keys are registered in the web UI at
# /settings/ssh-keys. Clone with:
#   git clone ssh://git@localhost:2222/<ns>/<name>.git
TF_SSH_ENABLED=true
TF_SSH_ADDR=:2222
# The port clients should dial, when a port mapping or a load balancer puts the
# listener somewhere else than TF_SSH_ADDR. This is what the repository page
# advertises as the SSH clone URL, so getting it wrong hands every user a URL
# that does not connect. Leave empty when nothing remaps the port.
# TF_SSH_PUBLIC_PORT=
# The host key is generated on first start if missing. It MUST live on
# persistent storage: on an ephemeral filesystem every restart mints a new
# identity and clients see a host key mismatch.
TF_SSH_HOST_KEY_PATH=/data/ssh/host_ed25519
TF_SSH_IDLE_TIMEOUT=10m

# How many connections one source address may hold before it authenticates,
# and the same cap process-wide. 0 means the server's own defaults (8 and 512).
# Raise the per-address one behind NAT or a bastion, where many real clients
# arrive as a single address; it is released the moment auth succeeds.
TF_SSH_MAX_UNAUTH_CONNS_PER_ADDR=0
TF_SSH_MAX_UNAUTH_CONNS=0

# ---- web / frontend ----------------------------------------------------
# Browser-facing API URL. Keep this pointed at localhost even though the
# `web` container reaches `api` via the internal `API_URL` value, since the
# browser itself is outside the compose network.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Continuity / WAL (docs/dev/continuity-design.md) ---
# off | shadow | authoritative
TF_WAL_MODE=shadow
# TF_GIT_HOOKS_PATH (core.hooksPath baked into the image; required whenever
# TF_WAL_MODE != off) is NOT settable here, unlike everything else in this
# file: docker-compose.yml's `api` service sets it as a bare literal
# (/opt/thinkingface/hooks) rather than ${TF_GIT_HOOKS_PATH:-...}, the same
# way it hardcodes GIT_ROOT, so a value here is silently ignored by
# `make up` / `make up-sqlite`. It only matters if you run the api binary
# outside this compose file.
# byte budget for the materialised-repository cache under GIT_ROOT (tmpfs on Cloud Run)
TF_GIT_CACHE_BYTES=2147483648
# byte budget for the parquet viewer's in-process footer/metadata cache.
# This is heap memory, not tmpfs/disk -- the viewer reads parquet objects
# from storage via range requests rather than caching them to disk.
TF_VIEWER_METADATA_CACHE_BYTES=268435456
