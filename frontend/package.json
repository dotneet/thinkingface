{
  "name": "thinkingface-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "duckdb-assets": "bun scripts/copy-duckdb-assets.mjs",
    "dev": "bun scripts/copy-duckdb-assets.mjs && next dev",
    "build": "bun scripts/copy-duckdb-assets.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "check:ui": "node scripts/check-ui.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.9",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.469.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.1",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
