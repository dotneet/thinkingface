# Backend URL as seen from the Next.js server: Server Component fetches and the
# same-origin /api proxy (app/api/[...path]/route.ts). Read at runtime. Inside
# docker compose this is the service name, e.g. http://api:8080.
API_URL=http://localhost:8080

# Backend URL as seen from the browser, inlined at build time. Leave it unset
# (or empty) and the browser calls this app's own origin, which proxies to
# API_URL. Set it only to have the browser call the API cross-origin, which
# also needs this app's origin in the API's TF_ALLOWED_ORIGINS.
# NEXT_PUBLIC_API_URL=http://localhost:8080
