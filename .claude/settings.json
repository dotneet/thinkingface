{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format-edited-file.sh\""
          }
        ]
      }
    ]
  }
}
